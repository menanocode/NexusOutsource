generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Candidate {
  id           String                @id @default(cuid())
  fullName     String
  email        String                @unique
  phone        String?
  nikEncrypted String                // NIK KTP encrypted with AES-256-GCM
  resumeUrl    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  applications Application[]
  documents    CandidateDocument[]
  scores       CandidateScore[]
  notifications Notification[]
}

model Partner {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users     PartnerUser[]
  jobs      Job[]
  feedbacks PartnerFeedback[]
}

model PartnerUser {
  id           String   @id @default(cuid())
  partnerId    String
  email        String   @unique
  passwordHash String
  role         String   // e.g. "OWNER", "RECRUITER", "INTERVIEWER"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id])
}

model Job {
  id          String        @id @default(cuid())
  partnerId   String
  title       String
  description String?
  status      String        @default("OPEN")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  partner      Partner       @relation(fields: [partnerId], references: [id])
  applications Application[]
}

model Application {
  id           String             @id @default(cuid())
  candidateId  String
  jobId        String
  status       String             @default("APPLIED")
  submittedAt  DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  candidate Candidate  @relation(fields: [candidateId], references: [id])
  job       Job        @relation(fields: [jobId], references: [id])
  stages    ApplicationStage[]
  scores    CandidateScore[]
  feedbacks PartnerFeedback[]
}

model ApplicationStage {
  id            String     @id @default(cuid())
  applicationId String
  name          String
  order         Int
  status        String     @default("PENDING") // e.g. "PENDING", "PASSED", "FAILED"
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  application Application @relation(fields: [applicationId], references: [id])
}

model CandidateDocument {
  id          String   @id @default(cuid())
  candidateId String
  type        String   // e.g. "CV", "PORTFOLIO", "CERTIFICATE"
  url         String
  uploadedAt  DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id])
}

model ScoringTemplate {
  id          String            @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  criteria ScoringCriterion[]
}

model ScoringCriterion {
  id              String          @id @default(cuid())
  templateId      String
  name            String
  description     String?
  maxScore        Int
  weight          Float           @default(1.0)

  template ScoringTemplate @relation(fields: [templateId], references: [id])
  scores   CandidateScore[]
}

model CandidateScore {
  id           String           @id @default(cuid())
  applicationId String
  candidateId String
  criterionId String
  score       Int
  notes       String?
  createdAt   DateTime          @default(now())

  application Application      @relation(fields: [applicationId], references: [id])
  candidate   Candidate        @relation(fields: [candidateId], references: [id])
  criterion   ScoringCriterion @relation(fields: [criterionId], references: [id])
}

model Notification {
  id          String   @id @default(cuid())
  candidateId String
  title       String
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id])
}

model FcmToken {
  id          String   @id @default(cuid())
  candidateId String?
  partnerUserId String?
  token       String   @unique
  platform    String?  // "ios", "android", "web"
  createdAt   DateTime @default(now())

  candidate   Candidate?   @relation(fields: [candidateId], references: [id])
  partnerUser PartnerUser? @relation(fields: [partnerUserId], references: [id])
}

model PartnerFeedback {
  id            String      @id @default(cuid())
  applicationId String
  partnerId     String
  authorId      String?     // PartnerUser who wrote it
  rating        Int?
  comment       String?
  createdAt     DateTime    @default(now())

  application Application @relation(fields: [applicationId], references: [id])
  partner     Partner     @relation(fields: [partnerId], references: [id])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AvailabilityStatus {
  AVAILABLE
  WORKING
  NOT_AVAILABLE
}

model candidates {
  id                  String                @id @default(uuid())
  full_name           String
  email               String                @unique
  phone               String?
  nik_ktp_encrypted   String?
  address             String?
  education_level     String?
  institution         String?
  major               String?
  years_of_experience Int?                  @default(0)
  photo_url           String?
  cv_url              String?
  availability_status AvailabilityStatus    @default(AVAILABLE)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt

  applications        applications[]
  documents           candidate_documents[]
  notifications       notifications[]
  fcm_tokens          fcm_tokens[]
}

model partners {
  id            String          @id @default(uuid())
  company_name  String
  industry      String?
  pic_name      String?
  pic_email     String?
  pic_phone     String?
  address       String?
  logo_url      String?
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now())

  users         partner_users[]
  jobs          jobs[]
}

enum PartnerRole {
  ADMIN
  VIEWER
}

model partner_users {
  id            String              @id @default(uuid())
  partner_id    String
  full_name     String
  email         String              @unique
  password_hash String
  role          PartnerRole         @default(VIEWER)
  is_active     Boolean             @default(true)
  created_at    DateTime            @default(now())

  partner       partners            @relation(fields: [partner_id], references: [id])
  feedbacks     partner_feedbacks[]
}

enum JobType {
  FULL_TIME
  CONTRACT
  DAILY
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model jobs {
  id                String              @id @default(uuid())
  partner_id        String
  title             String
  description       String?
  requirements      String?
  location          String?
  job_type          JobType             @default(FULL_TIME)
  salary_min        Int?
  salary_max        Int?
  quota             Int                 @default(1)
  filled_count      Int                 @default(0)
  status            JobStatus           @default(DRAFT)
  deadline          DateTime?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  partner           partners            @relation(fields: [partner_id], references: [id])
  applications      applications[]
  scoring_templates scoring_templates[]
}

enum AppStage {
  APPLIED
  SCREENING
  SHORTLISTED
  SUBMITTED
  INTERVIEW
  HIRED
  REJECTED
}

model applications {
  id               String               @id @default(uuid())
  candidate_id     String
  job_id           String
  current_stage    AppStage             @default(APPLIED)
  rejection_reason String?
  applied_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt

  candidate        candidates           @relation(fields: [candidate_id], references: [id])
  job              jobs                 @relation(fields: [job_id], references: [id])
  stages           application_stages[]
  scores           candidate_scores[]
  feedbacks        partner_feedbacks[]
}

model application_stages {
  id             String       @id @default(uuid())
  application_id String
  stage          AppStage
  changed_by     String?
  notes          String?
  changed_at     DateTime     @default(now())

  application    applications @relation(fields: [application_id], references: [id])
}

enum DocType {
  CV
  KTP
  IJAZAH
  SKCK
  OTHER
}

model candidate_documents {
  id              String     @id @default(uuid())
  candidate_id    String
  doc_type        DocType    @default(OTHER)
  file_url        String
  file_name       String?
  file_size_bytes Int?
  is_verified     Boolean    @default(false)
  uploaded_at     DateTime   @default(now())

  candidate       candidates @relation(fields: [candidate_id], references: [id])
}

model scoring_templates {
  id            String             @id @default(uuid())
  job_id        String
  template_name String
  created_at    DateTime           @default(now())

  job           jobs               @relation(fields: [job_id], references: [id])
  criteria      scoring_criteria[]
}

model scoring_criteria {
  id            String             @id @default(uuid())
  template_id   String
  criteria_name String
  weight        Float              @default(1.0)
  max_score     Int                @default(100)

  template      scoring_templates  @relation(fields: [template_id], references: [id])
  scores        candidate_scores[]
}

model candidate_scores {
  id             String           @id @default(uuid())
  application_id String
  criteria_id    String
  score          Float
  scored_by      String?
  scored_at      DateTime         @default(now())

  application    applications     @relation(fields: [application_id], references: [id])
  criteria       scoring_criteria @relation(fields: [criteria_id], references: [id])
}

enum NotifChannel {
  FCM
  WHATSAPP
  EMAIL
}

enum NotifStatus {
  SENT
  DELIVERED
  FAILED
}

model notifications {
  id           String       @id @default(uuid())
  candidate_id String
  title        String
  body         String
  channel      NotifChannel @default(FCM)
  status       NotifStatus  @default(SENT)
  payload      Json?
  sent_at      DateTime     @default(now())

  candidate    candidates   @relation(fields: [candidate_id], references: [id])
}

model fcm_tokens {
  id            String     @id @default(uuid())
  candidate_id  String
  device_token  String     @unique
  device_info   String?
  is_active     Boolean    @default(true)
  registered_at DateTime   @default(now())

  candidate     candidates @relation(fields: [candidate_id], references: [id])
}

enum FeedbackDecision {
  PENDING
  INTERVIEW
  HIRED
  REJECTED
}

model partner_feedbacks {
  id              String           @id @default(uuid())
  application_id  String
  partner_user_id String
  rating          Int?
  comment         String?
  decision        FeedbackDecision @default(PENDING)
  created_at      DateTime         @default(now())

  application     applications     @relation(fields: [application_id], references: [id])
  partner_user    partner_users    @relation(fields: [partner_user_id], references: [id])
}

enum AdminRole {
  SUPER_ADMIN
  RECRUITER
  VIEWER
}

model admin_users {
  id            String    @id @default(uuid())
  full_name     String
  email         String    @unique
  password_hash String
  role          AdminRole @default(RECRUITER)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
}
